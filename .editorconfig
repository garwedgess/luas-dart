root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = 120

ktlint_standard_no-unused-imports = enabled
ktlint_standard_import-ordering = enabled

# Trailing comma settings - align with Detekt
ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false

# Function naming - allow Composable functions to use PascalCase
ktlint_function_naming_ignore_when_annotated_with = Composable, Test, Preview, ThemePreview, ThemePreviewWithBackground

# Disable rules that conflict with Detekt or are too strict
ktlint_standard_backing-property-naming = disabled
ktlint_standard_binary-expression-wrapping = disabled
ktlint_standard_chain-method-continuation = disabled
ktlint_standard_class-signature = disabled
ktlint_standard_condition-wrapping = disabled
ktlint_standard_function-expression-body = disabled
ktlint_standard_function-literal = disabled
ktlint_standard_function-type-modifier-spacing = disabled
ktlint_standard_multiline-loop = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_parameter-wrapping = disabled
ktlint_standard_value-argument-comment = disabled
ktlint_standard_value-parameter-comment = disabled

[app/src/test/**/*.kt]
max_line_length = off

[*.md]
trim_trailing_whitespace = false