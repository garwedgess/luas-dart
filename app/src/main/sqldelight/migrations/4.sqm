CREATE TABLE TimetableFeed (
    Transport TEXT NOT NULL PRIMARY KEY,
    ETag TEXT,
    LastModified TEXT,
    DownloadedAtMillis INTEGER NOT NULL,
    CheckedAtMillis INTEGER NOT NULL,
    ValidFromDay INTEGER NOT NULL,
    ValidUntilDay INTEGER NOT NULL,
    Zone TEXT NOT NULL,
    Version TEXT NOT NULL,
    MaxDepartureSeconds INTEGER NOT NULL
);

CREATE TABLE TimetableStation (
    Transport TEXT NOT NULL,
    StationId TEXT NOT NULL,
    Name TEXT NOT NULL,
    PRIMARY KEY (Transport, StationId)
);

CREATE TABLE TimetableTrip (
    Transport TEXT NOT NULL,
    TripId TEXT NOT NULL,
    ServiceId TEXT NOT NULL,
    Destination TEXT NOT NULL,
    Direction TEXT NOT NULL,
    Line TEXT NOT NULL,
    PRIMARY KEY (Transport, TripId)
);

CREATE TABLE TimetableTime (
    Transport TEXT NOT NULL,
    TripId TEXT NOT NULL,
    Sequence INTEGER NOT NULL,
    StationId TEXT NOT NULL,
    DepartureSeconds INTEGER NOT NULL,
    Headsign TEXT NOT NULL,
    PRIMARY KEY (Transport, TripId, Sequence)
);
CREATE INDEX TimetableStationTimeIndex ON TimetableTime(Transport, StationId);

CREATE TABLE TimetableCalendar (
    Transport TEXT NOT NULL,
    ServiceId TEXT NOT NULL,
    Weekdays INTEGER NOT NULL,
    StartDay INTEGER NOT NULL,
    EndDay INTEGER NOT NULL,
    PRIMARY KEY (Transport, ServiceId)
);

CREATE TABLE TimetableException (
    Transport TEXT NOT NULL,
    ServiceId TEXT NOT NULL,
    Day INTEGER NOT NULL,
    Added INTEGER NOT NULL,
    PRIMARY KEY (Transport, ServiceId, Day)
);
